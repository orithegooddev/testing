<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>peak</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <h1>peak</h1>

    <!-- information dropdown -->
    <div class="info-wrap">
        <button id="openInfo" class="btn-pill" onclick="info('open')">Info</button>

        
        <div id="infoText">
            <div class="info-card">
                <p>Alex is alowing me to edit, Big mistake</p>
            </div>
            <button class="btn-pill" onclick="info('close')">Close</button>
        </div>
    </div>




    <!-- centering container -->
    <div class="center">

        <!-- where user messages are stored -->
        <div id="message_panel"></div>

        <!-- user input field -->
        <form id="inputForm">

                <textarea id="userInput" placeholder="send a message"></textarea>

                <button id="enterButton" onclick="enterMessage()">↑</button>
        </form>
    </div>




    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        last_name_div = null;
        last_id = -1;
        frame = 0;

        window.onload = async () => {
            // load saved message history
            const get_data = await fetch("/get_data");
            const data = await get_data.json();
            if (data.length > 0) {
                data.forEach(msg => updateHistory(msg.id, msg.user, msg.message));
            }

            // handle enter key input
            document.getElementById("userInput").addEventListener("keydown", function(event){
                // allow line breaks when shift key is down
                if (event.code === "Enter" && event.shiftKey) {
                    return;
                }
                // prevent line break and send a message
                else if (event.code === "Enter") {
                    event.preventDefault();
                    enterMessage();
                }
            });
        };

        // smooth scroll to bottom of message panel
        function scrollToBottom() {
            const message_panel = document.getElementById("message_panel");
            message_panel.scrollTo({
                top: message_panel.scrollHeight,
                behavior: "smooth"
            });
        }

        // main update function (for checking for new messages)
        async function update() {
            frame += 1;
            console.log(last_id)
            if ((frame % 100) == 0)
            {
                const get_data = await fetch("/get_data");
                const data = await get_data.json();
                if (data.length > 0) {
                    data.forEach(msg => updateHistory(msg.id, msg.user, msg.message));
                }
            }

            requestAnimationFrame(update);
        }

        requestAnimationFrame(update);

        function updateHistory(id, role, content) {
            const log = document.getElementById("message_panel");

            if (last_id >= id)
            {
                console.log("avoiding repeat")
                return;
            }
            
            console.log("continuing")

            //create div for storing user messages
            current_name = role == "user" ? "<b>You</b><br>" : "<b>Other</b><br>";

            if(last_name_div == null || last_name_div.innerHTML != current_name)
            {
                const name_div = document.createElement("div");
                name_div.className = role == "user" ? "name-user" : "name-other";
                name_div.innerHTML = current_name;

                last_name_div = name_div;
                log.appendChild(name_div);
            }

            const text_div = document.createElement("div");
            text_div.className = role == "user" ? "msg-user" : "msg-other";
            text_div.innerHTML = marked.parse(content);

            last_id = id;
            log.appendChild(text_div);

            scrollToBottom();
        }
        
        async function enterMessage() {
            const message = document.getElementById("userInput").value;
            const log = document.getElementById("message_panel");
            
            //prevent sending empty messages
            if (message === "") {
                return;
            }
            
            //clear input box
            document.getElementById("inputForm").reset();

            updateHistory(last_id+1, "user", message);

            log.scrollTo({
                top: log.scrollHeight,
                behavior: "smooth"
            });

            const sentMesage = await fetch("/main", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({message: message, user: "test"})
            });

            scrollToBottom();
        }
        
        function info(action) {
            const openButton = document.getElementById("openInfo");
            const infoText = document.getElementById("infoText");

            if (action == "open") {
                openButton.style.display = "none";
                infoText.style.display = "flex";
            }

            if (action == "close") {
                openButton.style.display = "";
                infoText.style.display = "none";
            }
        }
    </script>

    <style>
        /* ---------- design tokens ---------- */
        :root {
            --bg: #0c0d14;
            --bg-glow-a: rgba(90, 92, 224, 0.16);
            --bg-glow-b: rgba(56, 189, 248, 0.07);
            --surface: #151722;
            --surface-2: #1d2030;
            --surface-3: #262a3d;
            --line: #2a2e44;
            --line-soft: #1f2236;
            --text: #e8e9f3;
            --text-dim: #9a9db8;
            --text-faint: #6a6e8a;
            --accent: #5a5ce0;
            --accent-hi: #7b7dff;
            --accent-lo: #4143c4;
            --radius-lg: 22px;
            --radius-md: 16px;
            --font: "Plus Jakarta Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        /* ---------- base ---------- */
        * { box-sizing: border-box; }

        html {
            color-scheme: dark;
            background: var(--bg);
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: var(--font);
            color: var(--text);
            background:
                radial-gradient(900px 500px at 15% -10%, var(--bg-glow-a), transparent 60%),
                radial-gradient(700px 420px at 100% 0%, var(--bg-glow-b), transparent 60%),
                var(--bg);
            background-attachment: fixed;
            -webkit-font-smoothing: antialiased;
            padding: 28px 20px 40px;
        }

        h1 {
            margin: 0 0 22px;
            text-align: center;
            font-size: clamp(2.2rem, 5vw, 3.1rem);
            font-weight: 800;
            letter-spacing: -0.045em;
            line-height: 1;
            color: var(--text);
        }

        /* ---------- info dropdown ---------- */
        .info-wrap {
            position: absolute;
            top: 24px;
            right: 24px;
            z-index: 10;
        }

        #infoText {
            display: none;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
            animation: pop-in 0.18s ease-out;
        }

        .info-card {
            width: min(280px, 80vw);
            padding: 14px 16px;
            border-radius: var(--radius-md);
            border: 1px solid var(--line);
            background: var(--surface-2);
            box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.7);
            color: var(--text);
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .info-card p { margin: 0; }

        .btn-pill {
            font-family: var(--font);
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-dim);
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 8px 18px;
            cursor: pointer;
            transition: color 0.15s, border-color 0.15s, background 0.15s;
        }

        .btn-pill:hover {
            color: var(--text);
            border-color: var(--accent);
            background: var(--surface-2);
        }

        .btn-pill:focus-visible,
        #enterButton:focus-visible {
            outline: 2px solid var(--accent-hi);
            outline-offset: 2px;
        }

        @keyframes pop-in {
            from { opacity: 0; transform: translateY(-6px) scale(0.98); }
            to   { opacity: 1; transform: none; }
        }

        /* ---------- centering container ---------- */
        .center {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            max-width: 640px;
            margin: 0 auto;
        }

        /* ---------- message panel ---------- */
        #message_panel {
            display: flex;
            flex-direction: column;
            width: 100%;
            height: min(560px, calc(100vh - 240px));
            min-height: 320px;
            overflow-y: auto;
            padding: 18px 18px 22px;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            box-shadow:
                0 30px 60px -30px rgba(0, 0, 0, 0.8),
                inset 0 1px 0 rgba(255, 255, 255, 0.03);
            scrollbar-width: thin;
            scrollbar-color: var(--surface-3) transparent;
        }

        #message_panel::-webkit-scrollbar { width: 8px; }
        #message_panel::-webkit-scrollbar-track { background: transparent; margin: 14px 0; }
        #message_panel::-webkit-scrollbar-thumb {
            background: var(--surface-3);
            border-radius: 8px;
        }
        #message_panel::-webkit-scrollbar-thumb:hover { background: var(--line); }

        /* ---------- input bar ---------- */
        #inputForm {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            width: 100%;
            margin: 14px 0 0;
            padding: 8px;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.8);
            transition: border-color 0.18s, box-shadow 0.18s;
        }

        #inputForm:focus-within {
            border-color: var(--accent);
            box-shadow:
                0 0 0 4px rgba(90, 92, 224, 0.18),
                0 20px 40px -24px rgba(0, 0, 0, 0.8);
        }

        #userInput {
            flex: 1;
            min-width: 0;
            min-height: 50px;
            max-height: 160px;
            padding: 14px 8px 14px 14px;
            font-family: var(--font);
            font-size: 0.95rem;
            line-height: 1.4;
            color: var(--text);
            background: transparent;
            border: none;
            outline: none;
            resize: none;
        }

        #userInput::placeholder { color: var(--text-faint); }

        #enterButton {
            flex: none;
            width: 50px;
            height: 50px;
            padding: 0;
            font-family: var(--font);
            font-size: 22px;
            font-weight: 700;
            line-height: 1;
            color: #fff;
            background: linear-gradient(145deg, var(--accent-hi), var(--accent-lo));
            border: none;
            border-radius: var(--radius-md);
            cursor: pointer;
            box-shadow: 0 8px 20px -8px rgba(90, 92, 224, 0.8);
            transition: transform 0.12s, box-shadow 0.15s, filter 0.15s;
        }

        #enterButton:hover {
            filter: brightness(1.12);
            box-shadow: 0 10px 24px -8px rgba(123, 125, 255, 0.9);
        }

        #enterButton:active { transform: scale(0.94); }

        /* ---------- message bubbles ---------- */
        .msg-user,
        .msg-other {
            margin-top: 5px;
            padding: 9px 15px;
            width: fit-content;
            max-width: 82%;
            font-size: 0.95rem;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .msg-user {
            color: #fff;
            background: linear-gradient(145deg, var(--accent-hi), var(--accent-lo));
            border-radius: 20px 20px 6px 20px;
            align-self: flex-end;
            box-shadow: 0 8px 20px -12px rgba(90, 92, 224, 0.9);
        }

        .msg-other {
            color: var(--text);
            background: var(--surface-3);
            border: 1px solid var(--line);
            border-radius: 20px 20px 20px 6px;
            align-self: flex-start;
        }

        /* markdown inside bubbles */
        .msg-user > :first-child,
        .msg-other > :first-child { margin-top: 0; }
        .msg-user > :last-child,
        .msg-other > :last-child { margin-bottom: 0; }

        .msg-user p, .msg-other p { margin: 0.45em 0; }
        .msg-user ul, .msg-user ol,
        .msg-other ul, .msg-other ol { margin: 0.45em 0; padding-left: 1.3em; }

        .msg-user a { color: #fff; text-decoration: underline; text-underline-offset: 2px; }
        .msg-other a { color: var(--accent-hi); text-underline-offset: 2px; }

        .msg-user code, .msg-other code {
            font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
            font-size: 0.85em;
            padding: 0.15em 0.4em;
            border-radius: 6px;
            background: rgba(0, 0, 0, 0.3);
        }

        .msg-user pre, .msg-other pre {
            margin: 0.6em 0;
            padding: 12px 14px;
            overflow-x: auto;
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.35);
        }

        .msg-user pre code, .msg-other pre code {
            padding: 0;
            background: none;
        }

        .msg-other blockquote, .msg-user blockquote {
            margin: 0.5em 0;
            padding-left: 12px;
            border-left: 3px solid var(--accent-hi);
            color: var(--text-dim);
        }

        .msg-user blockquote { color: rgba(255, 255, 255, 0.8); border-color: rgba(255, 255, 255, 0.5); }

        /* for displaying user name, outside of text bubble */
        .name-user,
        .name-other {
            margin-top: 14px;
            padding: 0 6px;
            width: fit-content;
            font-size: 0.75rem;
            line-height: 1.2;
            color: var(--text-faint);
        }

        .name-user b,
        .name-other b { font-weight: 600; letter-spacing: 0.01em; }

        .name-user  { align-self: flex-end; }
        .name-other { align-self: flex-start; }

        .name-user:first-child,
        .name-other:first-child { margin-top: 0; }

        /* ---------- small screens ---------- */
        @media (max-width: 560px) {
            body { padding: 20px 12px 28px; }
            .info-wrap { top: 14px; right: 14px; }
            h1 { text-align: left; padding-left: 4px; }
            #message_panel { padding: 14px 12px 18px; }
            .msg-user, .msg-other { max-width: 90%; }
        }

        @media (prefers-reduced-motion: reduce) {
            * { animation: none !important; transition: none !important; }
        }
    </style>
</body>
</html>
